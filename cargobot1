            local starPulse = function(ds)
                local w,h = obj:getSize()
                obj:setSize(w+ds,h+ds)
                local x,y = obj:getPos()
                obj:translate(-ds/2,-ds/2)
            end
            
            local grow = false
            local tweenerMaker
            tweenerMaker = function()
                -- reset the size to make sure the size doesnt diverge over time
                if not grow then
                    local w,h = obj:getSize()
                    starPulse(35 - w)
                end
                
                local count = 0
                local f = function()
                    count = count + 1
                    if count > 3 then

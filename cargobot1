    self.score = score
    
    -- back arrow
    local arrow = Button(10,HEIGHT - 37,13,27)
    arrow:flipX()
    self:doDraw(arrow,"Cargo Bot:How Arrow")
    self:add(arrow)
    arrow.onEnded = function(obj,t)
        Events.trigger("levelSelect",self,true)
    end
    

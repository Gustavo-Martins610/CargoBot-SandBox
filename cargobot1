function checkLevelOrder()
    for p = 1,6 do
        local pack = packs[p]
        for i = 1,6 do
            local level = levels[(p-1)*6+i]
            local n1 = level.name
            local n2 = pack.levels[i]
            assert(n1==n2,"level order is wrong "..p.." "..i..
                "\n-"..n1.."-\n-"..n2.."-")
        end
    end
